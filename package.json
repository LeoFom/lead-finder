{
  "name": "lead-finder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.14 <25"
  },
  "scripts": {
    "dev": "pnpm --filter \"./packages/**\" build && pnpm --parallel --filter \"./apps/**\" dev",
    "build": "pnpm -r --if-present run build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm --filter \"./packages/**\" build && pnpm -r --if-present run typecheck && tsc -p tests/tsconfig.json",
    "test": "node --test tests/*.test.mts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:validate": "pnpm --filter @lead-finder/db validate",
    "db:check": "pnpm --filter @lead-finder/db check",
    "test:api": "node --test tests/api.integration.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.50.0",
    "tsx": "^4.20.0"
  }
}
