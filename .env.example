# Local development only. Use managed secrets and a separate URL on Render.
POSTGRES_USER=lead_finder
POSTGRES_PASSWORD=local_dev_only
POSTGRES_DB=lead_finder
DATABASE_URL=postgresql://lead_finder:local_dev_only@127.0.0.1:5432/lead_finder
API_PROXY_KEY=local-dev-proxy-key-replace-for-production
OWNER_SETUP_TOKEN=local-dev-setup-token-replace-for-production
WEB_ORIGINS=http://localhost:3000
# Next.js server env. API_PROXY_KEY must match the API service.
API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_DATA_MODE=api
